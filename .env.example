# Reservation form backend — see scripts/apps-script/booking-notification.gs
# for the Google Apps Script to deploy and get this URL from.
NEXT_PUBLIC_GAS_WEB_APP_URL=

# Canonical site origin, used for metadata and link previews. Set this in
# Vercel to the live domain, no trailing slash — e.g. https://hairbybelles.com
# Left unset, the site falls back to Vercel's production domain, then to
# localhost in development.
NEXT_PUBLIC_SITE_URL=
